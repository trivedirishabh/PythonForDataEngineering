      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SOLUTIONS\n\n   - Transforms in batches (10k rows by default)\n\n   -  Convert column to Arrow Format\n\n   -  Python function calls are fewer",
      "autoResize": true,
      "lineHeight": 1.25
    },
