      "text": "spark-submit is the command-line tool that is used to submit a\nspark application to a cluster",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "spark-submit is the command-line tool that is used to submit a\nspark application to a cluster",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gFa7PS4l3_6JAfcIZlK26",
      "type": "text",
      "x": 3211.912602437825,
      "y": 27300.9629859785,
      "width": 494.99969482421875,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2YY",
      "roundness": null,
      "seed": 223076875,
      "version": 67,
      "versionNonce": 381893163,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771445697723,
      "link": null,
      "locked": false,
      "text": "spark-submit \\\n  --master yarn \\\n  --deploy-mode cluster \\\n  --num-executors 4 \\\n  --executor-memory 4G \\\n  --executor-cores 2 \\\n  wordcount.py\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "spark-submit \\\n  --master yarn \\\n  --deploy-mode cluster \\\n  --num-executors 4 \\\n  --executor-memory 4G \\\n  --executor-cores 2 \\\n  wordcount.py\n",
      "autoResize": true,
      "lineHeight": 1.25
