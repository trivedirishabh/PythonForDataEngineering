    {
      "id": "Y7kSpjQW4tUbtLdVp3oga",
      "type": "text",
      "x": 1670.9932244918125,
      "y": 80598.3869305766,
      "width": 1331.0300445473863,
      "height": 188.77185821533206,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
