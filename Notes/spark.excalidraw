      "updated": 1770145131410,
      "link": null,
      "locked": false,
      "text": "In the below scenario, executor can't evict the \"Cached Data\" bcz\nthose blocks are currently in-use by other processs. \nThis also referred to as \"Pinned Blocks\"",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In the below scenario, executor can't evict the \"Cached Data\" bcz\nthose blocks are currently in-use by other processs. \nThis also referred to as \"Pinned Blocks\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
