      "type": "text",
      "x": 4169.470277406712,
      "y": 181959.6893987155,
      "width": 1050.580810546875,
      "height": 385.1754760742769,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
