      "text": "df = spark.read.load(\"examples/src/main/resources/dir1\",\n                     format=\"parquet\", modifiedBefore=\"2050-07-\n01T08:30:00\")\n\ndf = spark.read.load(\"examples/src/main/resources/dir1\",\n                     format=\"parquet\", modifiedAfter=\"2050-06-\n01T08:30:00\")",
      "fontSize": 36,
      "fontFamily": 6,
