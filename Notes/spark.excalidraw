      "isDeleted": false,
      "boundElements": [],
      "updated": 1771367621421,
      "link": null,
      "locked": false,
      "text": "SOLUTIONS\n\n   - Transforms in batches (10k rows by default)\n\n   -  Convert column to Arrow Format\n\n   -  Python function calls are fewer",
