      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1Fr",
      "roundness": null,
      "seed": 404707059,
      "version": 377,
      "versionNonce": 1099745629,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769991015406,
      "link": null,
      "locked": false,
      "text": "Global Temporary Views are \"CLUSTER SCOPED\" that means you can \naccess them from any notebook attached to the same cluster. Whereas,\nTemporary Views are session-scoped which are not available in the other\nnotebooks bcz of new session.",
      "fontSize": 37.75437164306641,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Global Temporary Views are \"CLUSTER SCOPED\" that means you can \naccess them from any notebook attached to the same cluster. Whereas,\nTemporary Views are session-scoped which are not available in the other\nnotebooks bcz of new session.",
      "autoResize": true,
      "lineHeight": 1.25
    },
