    {
      "id": "yUZ82K24M7taY6N_lxR4R",
      "type": "text",
      "x": 718.086822663654,
      "y": 8253.652942962904,
      "width": 1031.9755859375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0dM",
      "roundness": null,
      "seed": 1630080761,
      "version": 199,
      "versionNonce": 513385751,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768936666061,
      "link": null,
      "locked": false,
      "text": "Apache Spark is just an alternative to Hadoop MapReduce.\nHDFS is still there. ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Apache Spark is just an alternative to Hadoop MapReduce.\nHDFS is still there. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ILgfGeY1rd0OeBrm7Bv-u",
      "type": "text",
      "x": 711.6445042771522,
      "y": 8119.970565839212,
      "width": 1076.0396728515625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0dN",
      "roundness": null,
      "seed": 729656697,
      "version": 176,
      "versionNonce": 1081272887,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768936666061,
      "link": null,
      "locked": false,
      "text": "Apache Spark is a unified distributed computing engine which \nallows us to process big data in parallel.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Apache Spark is a unified distributed computing engine which \nallows us to process big data in parallel.",
      "autoResize": true,
      "lineHeight": 1.25
    },
