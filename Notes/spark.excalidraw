      "verticalAlign": "middle",
      "containerId": "nOwyeoNXHIIKrPATXkpt9",
      "originalText": "df = spark.read.load(\"examples/src/main/resources/dir1\",\n                     format=\"parquet\", modifiedBefore=\"2050-07-01T08:30:00\")\n\ndf = spark.read.load(\"examples/src/main/resources/dir1\",\n                     format=\"parquet\", modifiedAfter=\"2050-06-01T08:30:00\")",
      "autoResize": true,
